<?xml version="1.0" encoding="utf-8"?>
<!-- This machine has no NuGet source configured globally, and the AOT publish needs
     Microsoft.DotNet.ILCompiler. Declaring the source here (rather than editing the
     user-level NuGet.Config) keeps the build reproducible on CI and on a fresh clone. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
